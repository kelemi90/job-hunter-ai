generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id  String  @id @default(uuid())
    email   String  @unique
    name    String?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    preferences JobPreferences?
}

model JobPreferences {
    id  String  @id @default(uuid())
    userId  String  @unique
    skills  String[] // Array of required/preferred skills
    location    String[] // Preferred locations (e.g., Helsinki, Oulu)
    cvText  String? // Full text of candidate's cvText
    minSalary   Int?
    maxSalary   Int?
    remoteOnly  Boolean @default(false)
    seniorityLevel  String? // e.g., Junior, Mid, Senior
    languages   String[] @default(("English"))

    user    User    @relation(fields: [userId], references: [id])
}

model JobPosting {
    id  String  @id @default(uuid())
    externalId  String  @unique // ID from the job board (e.g., Duunitori ID)
    source  String // e.g., "Duunitori", "Työmarkkinatori"
    title   String
    companyName String
    location    String?
    description String?
    url     String
    publishedAt DateTime
    scrapedAt   DateTime @default(now())

    matches JobMatch[]
}

model JobMatch {
    id  String  @id @default(uuid())
    jobId   String
    userId  String
    score   Int
    explanation String? // AI generated explanation
    status  MatchStatus @default(PENDING)
    createdAt   DateTime    @default(now())

    job JobPosting @relation(fields: [jobId], references: [id])

    @@unique((jobId, userId))
}

enum MatchStatus {
    PENDING
    VIEWED
    APPLIED
    REJECTED
    SAVED
}